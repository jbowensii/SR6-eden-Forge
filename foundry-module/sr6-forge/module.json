{
  "id": "sr6-forge",
  "title": "SR6 Forge \u2014 Character Generation & Advancement",
  "description": "Full character generation and karma advancement for Shadowrun 6th World on the shadowrun6-eden system. Five creation methods (Priority, Sum-to-Ten, Point Buy, Karma, Life Path), itemised budgets, and an append-only advancement ledger.",
  "version": "0.9.21",
  "compatibility": {
    "minimum": "14",
    "verified": "14.365",
    "maximum": "14"
  },
  "authors": [
    {
      "name": "SR6-eden-Forge"
    }
  ],
  "esmodules": [
    "scripts/main.mjs"
  ],
  "styles": [
    "styles/sr6-forge.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ],
  "relationships": {
    "systems": [
      {
        "id": "shadowrun6-eden",
        "type": "system",
        "compatibility": {
          "minimum": "4.0.0"
        }
      }
    ],
    "recommends": [
      {
        "id": "sr6-forge-corebook",
        "type": "module",
        "reason": "Shadowrun 6th World Catalog \u2014 the compendium the wizard shops from. Build it from books you own with the catalog builder in this repository; it is not distributed.",
        "compatibility": {}
      }
    ]
  },
  "flags": {
    "hotReload": {
      "extensions": [
        "css",
        "hbs",
        "json"
      ],
      "paths": [
        "styles",
        "templates",
        "lang"
      ]
    }
  },
