<h2>Contacts</h2>
<p>{{contactHint}}</p>
<table class="data">
  <thead><tr><th>Name</th><th>Archetype</th><th style="width:66px">Conn</th><th style="width:66px">Loyal</th><th></th></tr></thead>
  <tbody>
    {{#each contacts}}
    <tr>
      <td><input type="text" value="{{name}}" placeholder="Contact name"
                 data-change="contactField" data-index="{{@index}}" data-field="name" /></td>
      <td>
        <select data-change="contactField" data-index="{{@index}}" data-field="archetypeId">
          <option value="">—</option>
          {{#each ../archetypes}}
          <option value="{{id}}" {{#if (eq id ../archetypeId)}}selected{{/if}}>{{name}}</option>
          {{/each}}
        </select>
      </td>
      <td><input type="number" min="1" max="6" value="{{connection}}"
                 data-change="contactField" data-index="{{@index}}" data-field="connection" /></td>
      <td><input type="number" min="1" max="6" value="{{loyalty}}"
                 data-change="contactField" data-index="{{@index}}" data-field="loyalty" /></td>
      <td><button type="button" class="x" data-action="removeContact" data-index="{{@index}}">✕</button></td>
    </tr>
    {{else}}
    <tr><td colspan="5"><div class="browse-empty">No contacts yet.</div></td></tr>
    {{/each}}
  </tbody>
</table>
<div class="browser-head"><button type="button" data-action="addContact">+ Add contact</button></div>
