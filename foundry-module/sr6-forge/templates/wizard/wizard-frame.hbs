<div class="wizard-grid">
  <nav class="step-rail">
    {{#each steps}}
    <button type="button" class="step {{#if active}}active{{/if}} {{#if done}}done{{/if}}"
            data-action="goto" data-step="{{id}}">{{index}}. {{label}}</button>
    {{/each}}
  </nav>
  <section class="step-body">
    {{{stepHtml}}}
  </section>
</div>

<footer>
  <div class="budget-bar">
    <span class="chip {{#if (lt budgets.attributePoints.left 0)}}over{{/if}}"
      title="{{localize 'SR6FORGE.Budget.attributePoints'}}">
      ATTR {{budgets.attributePoints.left}}/{{budgets.attributePoints.max}}</span>
    <span class="chip {{#if (lt budgets.adjustmentPoints.left 0)}}over{{/if}}"
      title="{{localize 'SR6FORGE.Budget.adjustmentPoints'}}">
      ADJ {{budgets.adjustmentPoints.left}}/{{budgets.adjustmentPoints.max}}</span>
    <span class="chip {{#if (lt budgets.skillPoints.left 0)}}over{{/if}}"
      title="{{localize 'SR6FORGE.Budget.skillPoints'}}">
      SKILL {{budgets.skillPoints.left}}/{{budgets.skillPoints.max}}</span>
    <span class="chip {{#if (lt budgets.karma.left 0)}}over{{/if}}"
      title="{{localize 'SR6FORGE.Budget.karma'}}">
      KARMA {{budgets.karma.left}}/{{budgets.karma.max}}</span>
    <span class="chip {{#if (lt budgets.nuyen.left 0)}}over{{/if}}"
      title="{{localize 'SR6FORGE.Budget.nuyen'}}">
      ¥ {{budgets.nuyen.left}}/{{budgets.nuyen.max}}</span>
    <span class="chip {{#if (lte budgets.essence.left 0)}}over{{/if}}"
      title="{{localize 'SR6FORGE.Budget.essence'}}">
      ESS {{budgets.essence.left}}</span>
    {{#if budgets.powerPoints.max}}
    <span class="chip {{#if (lt budgets.powerPoints.left 0)}}over{{/if}}"
      title="{{localize 'SR6FORGE.Budget.powerPoints'}}">
      PP {{budgets.powerPoints.left}}/{{budgets.powerPoints.max}}</span>
    {{/if}}
    <span class="chip {{#if (lt budgets.contactPoints.left 0)}}over{{/if}}"
      title="{{localize 'SR6FORGE.Budget.contactPoints'}}">
      CON {{budgets.contactPoints.left}}/{{budgets.contactPoints.max}}</span>
    {{#if errorCount}}<span class="chip over">{{errorCount}} ⚠</span>{{/if}}
  </div>
  <div class="wizard-nav">
    <button type="button" data-action="back" {{#if isFirst}}disabled{{/if}}>
      {{localize "SR6FORGE.Wizard.Back"}}</button>
    <button type="button" data-action="saveDraft">
      {{localize "SR6FORGE.Wizard.SaveDraft"}}</button>
    {{#if isLast}}
    <button type="button" data-action="finalize" {{#if errorCount}}disabled{{/if}}>
      {{localize "SR6FORGE.Wizard.Finalize"}}</button>
    {{else}}
    <button type="button" data-action="next">{{localize "SR6FORGE.Wizard.Next"}}</button>
    {{/if}}
  </div>
</footer>
