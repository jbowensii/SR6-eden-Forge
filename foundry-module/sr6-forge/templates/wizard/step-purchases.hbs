<h2>{{tabLabel}}</h2>
<div class="tabs">
  {{#each tabs}}
  <button type="button" class="{{#if active}}active{{/if}}" data-action="shopTab" data-tab="{{id}}"
          {{#unless enabled}}disabled title="requires a matching Magic/Resonance path"{{/unless}}>{{label}}</button>
  {{/each}}
</div>

{{!-- one search bar for every tab (gear, magic, lifestyle) --}}
{{#unless isLifestyleTab}}
<div class="browser-head">
  <label class="field grow">
    <span class="field-label">Search</span>
    <input type="search" data-filter="shop" placeholder="Search {{tabLabel}} by name…" value="{{query}}" />
  </label>
  {{#if subtypes.length}}
  <label class="field">
    <span class="field-label">Category</span>
    <select data-change="shopSubtype">
      <option value="">All categories ({{listTotal}})</option>
      {{#each subtypes}}
      <option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}} ({{count}})</option>
      {{/each}}
    </select>
  </label>
  {{/if}}
</div>
{{#if truncated}}
<p class="hint">Showing the first {{shown}} of {{listTotal}} — {{truncated}} more match; narrow with search or a category.</p>
{{/if}}
{{/unless}}

{{#if isMagicTab}}
  {{#unless magicKinds.length}}
  <p class="hint">This character has no Magic or Resonance path — nothing to learn here.</p>
  {{/unless}}
  {{#each magicKinds}}
  <h3>{{label}} ({{chosen.length}})</h3>
  <div class="chosen-list">
    {{#each chosen}}
    <div class="chosen">
      <span class="c-name">{{name}}
        {{#if ppText}}<span class="mt">{{ppText}}</span>{{/if}}
        {{#if hasLevel}}
        {{!-- leveled powers (Improved Reflexes 1/2/3) cost their PP per level --}}
        <span class="lvl">
          <label class="field-label">level</label>
          <select data-change="powerLevel" data-index="{{index}}" data-current="{{level}}">
            {{#each ../levels}}
            <option value="{{this}}" {{#if (eq this ../level)}}selected{{/if}}>{{this}}</option>
            {{/each}}
          </select>
        </span>
        {{/if}}
      </span>
      <button type="button" class="x" data-action="removePick" data-kind="{{../kind}}" data-uuid="{{uuid}}">✕</button>
    </div>
    {{/each}}
  </div>
  <div class="browse-list" data-filter-scope="shop">
    {{#each list}}
    <div class="row" data-filter-text="{{name}}" data-detail-kind="uuid" data-detail-id="{{uuid}}">
      <span class="nm">{{name}}</span>
      <span class="mt">{{meta}}</span>
      <button type="button" data-action="addPick" data-kind="{{../kind}}"
              data-uuid="{{uuid}}" data-name="{{name}}" data-genesis-id="{{genesisID}}"
              data-cost="{{cost}}">{{#if ../isPower}}Take{{else}}Learn{{/if}}</button>
    </div>
    {{else}}
    <div class="browse-empty">Nothing matches.</div>
    {{/each}}
  </div>
  {{/each}}

{{else if isLifestyleTab}}
  <h3>Lifestyle</h3>
  <select data-change="lifestyle">
    <option value="">— none —</option>
    {{#each lifestyles}}
    <option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}} — {{cost}}¥/month</option>
    {{/each}}
  </select>
  <h3>SINs &amp; Licenses</h3>
  <div class="chosen-list">
    {{#each sins}}
    <div class="chosen">
      <span class="c-name">{{name}} <span class="c-meta">rating {{rating}}</span></span>
      <button type="button" class="x" data-action="removeSin" data-index="{{@index}}">✕</button>
    </div>
    {{/each}}
  </div>
  <div class="browser-head">
    {{#each sinRatings}}
    <button type="button" data-action="addSin" data-rating="{{this}}">+ Fake SIN R{{this}}</button>
    {{/each}}
  </div>

{{else}}
  <div class="browse-list" data-filter-scope="shop">
    {{#each list}}
    <div class="row {{#if overCap}}over{{/if}}" data-filter-text="{{name}}"
         data-detail-kind="uuid" data-detail-id="{{uuid}}">
      <span class="nm">{{name}}
        {{!-- tell the user BEFORE they buy that this thing takes accessories --}}
        {{#if mounts}}<span class="mount-badge" title="accepts accessories — fit them from the Owned list below">⛓ {{mounts}}</span>{{/if}}
      </span>
      <span class="mt">{{price}}¥ · A{{avail}}{{#if essence}} · E{{essence}}{{/if}}{{#if ratedFrom}} · rating {{ratedFrom}}{{/if}}</span>
      <button type="button" data-action="addPurchase" data-uuid="{{uuid}}" data-name="{{name}}"
              data-genesis-id="{{genesisID}}" data-subtype="{{subtype}}"
              data-sr6forge="{{json sr6forge}}"
              data-price="{{price}}" data-avail="{{avail}}" data-essence="{{essence}}"
              data-item-type="{{itemType}}" {{#if overCap}}disabled title="over availability cap"{{/if}}>Buy</button>
    </div>
    {{else}}
    <div class="browse-empty">Nothing matches.</div>
    {{/each}}
  </div>
{{/if}}

<h3>Owned ({{owned.length}}) — {{spentText}}</h3>
<p class="hint">Items marked ⛓ accept accessories; fit them from the dropdown on
   the owned entry.</p>
<div class="chosen-list">
  {{#each owned}}
  <div class="chosen owned-item">
    <span class="c-name">{{name}}{{#if qty}} ×{{qty}}{{/if}}
      <span class="c-meta">{{price}}¥{{#if essence}} · ess {{essence}}{{/if}}</span>
      {{#if ratings}}
      {{!-- rated gear prices per rating, so the rating is a live choice --}}
      <span class="rating-pick">
        <span class="field-label">rating</span>
        <select data-change="itemRating" data-index="{{index}}">
          {{#each ratingOptions}}
          <option value="{{n}}" {{#if selected}}selected{{/if}}>{{n}}</option>
          {{/each}}
        </select>
      </span>
      {{/if}}

      {{#if hasSlots}}
      {{!-- accessory mounts: what is fitted, and what will still fit --}}
      <span class="slots">
        {{#each slots}}<span class="slot {{#if taken}}taken{{/if}}">{{label}}</span>{{/each}}
      </span>
      {{#each accessories}}
      <span class="fitted">
        <span class="f-name">{{name}}</span>
        <span class="mt">{{slotLabel}}{{#if price}} · {{price}}¥{{/if}}</span>
        {{#if included}}<span class="mt">factory</span>
        {{else}}
        <button type="button" class="x" data-action="removeAccessory"
                data-index="{{../index}}" data-uuid="{{uuid}}">✕</button>
        {{/if}}
      </span>
      {{/each}}
      {{#if freeSlots}}
      <span class="add-acc">
        <select data-acc-for="{{index}}">
          <option value="">— fit an accessory —</option>
          {{#each offers}}
          <option value="{{uuid}}" data-genesis-id="{{genesisID}}" data-name="{{name}}"
                  data-price="{{price}}" data-avail="{{avail}}" data-slot="{{slot}}">
            {{name}} ({{slot}}, {{price}}¥)
          </option>
          {{/each}}
        </select>
        <button type="button" data-action="addAccessory" data-index="{{index}}"
                data-from-select="{{index}}">Fit</button>
      </span>
      {{/if}}
      {{/if}}
    </span>
    <button type="button" class="x" data-action="removePurchase" data-uuid="{{uuid}}">✕</button>
  </div>
  {{else}}
  <div class="browse-empty">Nothing purchased yet.</div>
  {{/each}}
</div>
