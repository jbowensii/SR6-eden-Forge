<h2>Purchases</h2>

<nav class="shop-tabs">
  {{#each tabs}}
  <button type="button" class="{{#if active}}active{{/if}}" data-action="shopTab" data-tab="{{id}}">{{id}}</button>
  {{/each}}
</nav>
<input type="search" data-search placeholder="Search…" value="{{query}}" />
<div class="item-browser">
  {{#each list}}
  <div class="row {{#if overCap}}disabled{{/if}}">
    <span class="name">{{name}}</span>
    <span class="meta">{{price}}¥ · avail {{avail}}{{#if essence}} · ess {{essence}}{{/if}}</span>
    <button type="button" data-action="addPurchase" data-uuid="{{uuid}}" data-name="{{name}}"
            data-price="{{price}}" data-avail="{{avail}}" data-essence="{{essence}}"
            data-item-type="{{itemType}}" {{#if overCap}}disabled{{/if}}>Buy</button>
  </div>
  {{/each}}
</div>

<h3>Owned</h3>
<ul>
  {{#each owned}}
  <li>{{name}} ×{{qty}} — {{price}}¥
    <button type="button" data-action="removePurchase" data-uuid="{{uuid}}">✕</button></li>
  {{/each}}
</ul>

{{#if canSpells}}
<h3>Spells ({{spells.length}})</h3>
<ul>{{#each spells}}<li>{{name}}
  <button type="button" data-action="removePick" data-kind="spell" data-uuid="{{uuid}}">✕</button></li>{{/each}}</ul>
<div class="item-browser">
  {{#each picks.spell}}
  <div class="row"><span class="name">{{name}}</span>
    <button type="button" data-action="addPick" data-kind="spell" data-uuid="{{uuid}}" data-name="{{name}}">Learn</button></div>
  {{/each}}
</div>
{{/if}}

{{#if canPowers}}
<h3>Adept Powers{{#if isMysticAdept}} (PP bought: {{ppBought}}){{/if}}</h3>
<ul>{{#each powers}}<li>{{name}}
  <button type="button" data-action="removePick" data-kind="power" data-uuid="{{uuid}}">✕</button></li>{{/each}}</ul>
<div class="item-browser">
  {{#each picks.power}}
  <div class="row"><span class="name">{{name}}</span>
    <button type="button" data-action="addPick" data-kind="power" data-uuid="{{uuid}}" data-name="{{name}}">Take</button></div>
  {{/each}}
</div>
{{/if}}

{{#if canCF}}
<h3>Complex Forms ({{complexForms.length}})</h3>
<ul>{{#each complexForms}}<li>{{name}}
  <button type="button" data-action="removePick" data-kind="complexform" data-uuid="{{uuid}}">✕</button></li>{{/each}}</ul>
<div class="item-browser">
  {{#each picks.complexform}}
  <div class="row"><span class="name">{{name}}</span>
    <button type="button" data-action="addPick" data-kind="complexform" data-uuid="{{uuid}}" data-name="{{name}}">Thread</button></div>
  {{/each}}
</div>
{{/if}}

<h3>Lifestyle & SINs</h3>
<select data-change="lifestyle">
  <option value=""></option>
  {{#each lifestyles}}
  <option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}} ({{cost}}¥/mo)</option>
  {{/each}}
</select>
<div class="sins">
  {{#each sins}}
  <span class="chip">{{name}} (R{{rating}})
    <button type="button" data-action="removeSin" data-index="{{@index}}">✕</button></span>
  {{/each}}
  <button type="button" data-action="addSin" data-rating="2">+ Fake SIN (R2)</button>
  <button type="button" data-action="addSin" data-rating="4">+ Fake SIN (R4)</button>
</div>
