<h2>{{tabLabel}}</h2>
<div class="tabs">
  {{#each tabs}}
  <button type="button" class="{{#if active}}active{{/if}}" data-action="shopTab" data-tab="{{id}}"
          {{#unless enabled}}disabled title="requires a matching Magic/Resonance path"{{/unless}}>{{label}}</button>
  {{/each}}
</div>

{{!-- one search bar for every tab (gear, magic, lifestyle) --}}
{{#unless isLifestyleTab}}
<div class="browser-head">
  <label class="field grow">
    <span class="field-label">Search</span>
    <input type="search" data-filter="shop" placeholder="Search all gear by name…" value="{{query}}" />
  </label>
  {{#if subtypes.length}}
  <label class="field">
    <span class="field-label">Category</span>
    <select data-change="shopSubtype">
      <option value="">All categories ({{listTotal}})</option>
      {{#each subtypes}}
      <option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}} ({{count}})</option>
      {{/each}}
    </select>
  </label>
  {{/if}}
</div>
{{#if searchedAll}}
<p class="hint">Searching every category — {{listTotal}} match{{#unless (eq listTotal 1)}}es{{/unless}}.
  Clear the search to browse this tab on its own.</p>
{{/if}}
{{#if truncated}}
<p class="hint">Showing the first {{shown}} of {{listTotal}} — {{truncated}} more match; narrow your search.</p>
{{/if}}
{{/unless}}

{{#if isMagicTab}}
  {{#unless magicKinds.length}}
  <p class="hint">This character has no Magic or Resonance path — nothing to learn here.</p>
  {{/unless}}
  {{#each magicKinds}}
  <h3>{{label}} ({{chosen.length}})</h3>
  <div class="chosen-list">
    {{#each chosen}}
    <div class="chosen">
      <span class="c-name">{{name}}
        {{#if ppText}}<span class="mt">{{ppText}}</span>{{/if}}
        {{#if hasLevel}}
        {{!-- leveled powers (Improved Reflexes 1/2/3) cost their PP per level --}}
        <span class="lvl">
          <label class="field-label">level</label>
          <select data-change="powerLevel" data-index="{{index}}" data-current="{{level}}">
            {{#each ../levels}}
            <option value="{{this}}" {{#if (eq this ../level)}}selected{{/if}}>{{this}}</option>
            {{/each}}
          </select>
        </span>
        {{/if}}
      </span>
      <button type="button" class="x" data-action="removePick" data-kind="{{../kind}}" data-uuid="{{uuid}}">✕</button>
    </div>
    {{/each}}
  </div>
  <div class="browse-list" data-filter-scope="shop">
    {{#each list}}
    <div class="row" data-filter-text="{{name}}" data-detail-kind="uuid" data-detail-id="{{uuid}}">
      <span class="nm">{{name}}</span>
      <span class="mt">{{meta}}</span>
      <button type="button" data-action="addPick" data-kind="{{../kind}}"
              data-uuid="{{uuid}}" data-name="{{name}}" data-catalog-id="{{catalogId}}"
              data-cost="{{cost}}">{{#if ../isPower}}Take{{else}}Learn{{/if}}</button>
    </div>
    {{else}}
    <div class="browse-empty">Nothing matches.</div>
    {{/each}}
  </div>
  {{/each}}

{{else if isPacksTab}}
  <p class="hint">Sixth World Companion PACKs — a curated kit for one price,
    which is lower than buying the parts separately. Buying one adds everything
    it contains; removing it takes all of that back.</p>
  {{#each packGroups}}
  <h3>{{label}}</h3>
  <div class="browse-list">
    {{#each packs}}
    <div class="browse-row pack-row {{#if owned}}owned{{/if}}">
      <span class="b-name">{{name}}
        <span class="b-sub">{{summary}}{{#if page}} · 6WC p{{page}}{{/if}}</span>
      </span>
      <span class="b-price">{{price}}¥{{#if essence}}<span class="b-ess"> · {{essence}} ess</span>{{/if}}</span>
      {{#if owned}}
      <button type="button" data-action="removePack" data-pack="{{id}}" title="{{description}}">Remove</button>
      {{else}}
      <button type="button" data-action="addPack" data-pack="{{id}}" title="{{description}}">Buy</button>
      {{/if}}
    </div>
    {{/each}}
  </div>
  {{/each}}

{{else if isLifestyleTab}}
  <h3>Lifestyle</h3>
  <select data-change="lifestyle">
    <option value="">— none —</option>
    {{#each lifestyles}}
    <option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}} — {{cost}}¥/month</option>
    {{/each}}
  </select>
  <h3>SINs &amp; Licences</h3>
  <p class="hint">Runners are SINless unless they take the SINner quality, which
    grants a real SIN (core p273). Fake SINs cost rating × 2,500¥ and fake
    licences rating × 200¥; each licence belongs to one SIN and cannot out-rate
    it (core p274). Give each SIN the name it is registered under.</p>
  <div class="sin-list">
    {{#each sins}}
    <div class="sin-card {{#if isReal}}real{{/if}}">
      <div class="sin-head">
        <span class="sin-kind">{{#if isReal}}REAL SIN{{else}}FAKE SIN R{{rating}}{{/if}}</span>
        <input type="text" class="sin-name" data-change="sinName" data-index="{{index}}"
               value="{{name}}" placeholder="{{#if isReal}}Legal name{{else}}Alias on this SIN{{/if}}" />
        <span class="sin-cost">{{cost}}¥</span>
        {{#if fromQuality}}
        <span class="mt" title="granted by the SINner quality — drop the quality to remove it">from quality</span>
        {{else}}
        <button type="button" class="x" data-action="removeSin" data-index="{{index}}">✕</button>
        {{/if}}
      </div>
      <div class="sin-lic">
        {{#each licenses}}
        <span class="fitted">
          <span class="f-name">{{name}}</span>
          <span class="mt">R{{rating}} · {{cost}}¥</span>
          <button type="button" class="x" data-action="removeLicense"
                  data-index="{{../index}}" data-license-index="{{@index}}">✕</button>
        </span>
        {{/each}}
        <span class="add-lic">
          <input type="text" data-lic-name="{{index}}" placeholder="Licence (e.g. firearms)" />
          <select data-lic-rating="{{index}}">
            {{#each ../../licenceRatings}}
            <option value="{{this}}">R{{this}}</option>
            {{/each}}
          </select>
          <button type="button" data-action="addLicense" data-index="{{index}}">+ Licence</button>
        </span>
      </div>
    </div>
    {{else}}
    <p class="hint">No SIN. Legal life is difficult without one.</p>
    {{/each}}
  </div>
  <div class="browser-head add-sin">
    <label class="field grow"><span class="field-label">New fake SIN</span>
      <input type="text" data-new-sin="name" placeholder="Alias" /></label>
    <label class="field"><span class="field-label">Rating</span>
      <select data-new-sin="rating">
        {{#each sinRatings}}<option value="{{this}}">R{{this}} — {{this}}×2,500¥</option>{{/each}}
      </select></label>
    <button type="button" data-action="addSin">+ Add fake SIN</button>
  </div>

{{else}}
  <div class="browse-list" data-filter-scope="shop">
    {{#each list}}
    <div class="row {{#if overCap}}over{{/if}}" data-filter-text="{{name}}"
         data-detail-kind="uuid" data-detail-id="{{uuid}}">
      <span class="nm">{{name}}
        {{!-- tell the user BEFORE they buy that this thing takes accessories --}}
        {{#if mounts}}<span class="mount-badge" title="accepts accessories — fit them from the Owned list below">⛓ {{mounts}}</span>{{/if}}
      </span>
      <span class="mt">{{#if where}}<span class="where">{{where}}</span> · {{/if}}{{price}}¥ · A{{avail}}{{#if essence}} · E{{essence}}{{/if}}{{#if ratedFrom}} · rating {{ratedFrom}}{{/if}}</span>
      <button type="button" data-action="addPurchase" data-uuid="{{uuid}}" data-name="{{name}}"
              data-catalog-id="{{catalogId}}" data-subtype="{{subtype}}" data-gear-type="{{gearType}}"
              data-sr6forge="{{json sr6forge}}"
              data-price="{{price}}" data-avail="{{avail}}" data-essence="{{essence}}"
              data-item-type="{{itemType}}" {{#if overCap}}disabled title="over availability cap"{{/if}}>Buy</button>
    </div>
    {{else}}
    <div class="browse-empty">Nothing matches.</div>
    {{/each}}
  </div>
{{/if}}

{{#unless isLifestyleTab}}
{{#unless isPacksTab}}
{{#unless isMagicTab}}
<h3>Custom item</h3>
<p class="hint">Anything the books do not cover. You set the price; it is spent
  like any other purchase and arrives on the sheet as ordinary gear.</p>
<div class="custom-item">
  <label class="field grow"><span class="field-label">Name</span>
    <input type="text" data-custom="name" placeholder="Custom item" /></label>
  <label class="field"><span class="field-label">Price ¥</span>
    <input type="number" data-custom="price" min="0" step="5" placeholder="0" /></label>
  <label class="field"><span class="field-label">Avail</span>
    <input type="number" data-custom="avail" min="0" placeholder="0" /></label>
  <label class="field"><span class="field-label">Rating</span>
    <input type="number" data-custom="rating" min="0" placeholder="—" /></label>
  <label class="field"><span class="field-label">Qty</span>
    <input type="number" data-custom="qty" min="1" value="1" /></label>
  <button type="button" data-action="addCustomItem">+ Add</button>
</div>
{{/unless}}
{{/unless}}
{{/unless}}

<h3>Owned ({{owned.length}}) — {{spentText}}</h3>
<p class="hint">Items marked ⛓ accept accessories; fit them from the dropdown on
   the owned entry.</p>
<div class="chosen-list">
  {{#each owned}}
  <div class="chosen owned-item">
    <span class="c-name">{{name}}{{#if showQty}} ×{{qty}}{{/if}}
      <span class="c-meta">{{price}}¥{{#if essence}} · ess {{essence}}{{/if}}</span>
      {{#if ratings}}
      {{!-- rated gear prices per rating, so the rating is a live choice --}}
      <span class="rating-pick">
        <span class="field-label">rating</span>
        <select data-change="itemRating" data-index="{{index}}">
          {{#each ratingOptions}}
          <option value="{{n}}" {{#if selected}}selected{{/if}}>{{n}}</option>
          {{/each}}
        </select>
      </span>
      {{/if}}

      {{#if hasSlots}}
      {{!-- accessory mounts: what is fitted, and what will still fit --}}
      <span class="slots">
        {{#if countedSlots}}<span class="slot-count">{{freeSlots}} of {{totalSlots}} hardpoints free</span>{{/if}}
        {{#each slots}}<span class="slot {{#if taken}}taken{{/if}}"
          title="{{#if unlimited}}no practical limit{{else}}{{used}} of {{total}} used{{/if}}">{{label}}
          <span class="s-tally">{{#if unlimited}}∞{{else}}{{tally}}{{/if}}</span></span>{{/each}}
      </span>
      {{#each accessories}}
      <span class="fitted">
        <span class="f-name">{{name}}</span>
        <span class="mt">{{slotLabel}}{{#if price}} · {{price}}¥{{/if}}</span>
        {{#if included}}<span class="mt">factory</span>
        {{else}}
        <button type="button" class="x" data-action="removeAccessory"
                data-index="{{../index}}" data-uuid="{{uuid}}">✕</button>
        {{/if}}
      </span>
      {{/each}}
      {{#if freeSlots}}
      <span class="add-acc">
        <select data-acc-for="{{index}}">
          <option value="">— fit an accessory —</option>
          {{#each offers}}
          <option value="{{uuid}}" data-catalog-id="{{catalogId}}" data-name="{{name}}"
                  data-price="{{price}}" data-avail="{{avail}}" data-slot="{{slot}}">
            {{name}} ({{slot}}, {{price}}¥)
          </option>
          {{/each}}
        </select>
        <button type="button" data-action="addAccessory" data-index="{{index}}"
                data-from-select="{{index}}">Fit</button>
      </span>
      {{/if}}
      {{/if}}
    </span>
    <button type="button" class="x" data-action="removePurchase" data-uuid="{{uuid}}">✕</button>
  </div>
  {{else}}
  <div class="browse-empty">Nothing purchased yet.</div>
  {{/each}}
</div>
