<h2>Qualities</h2>
<p>Positive qualities cost karma; negative qualities grant it.
   Core p67: at most <strong>{{maxCount}} qualities</strong>, and
   <strong>net bonus karma ≤ {{netCap}}</strong>.</p>
<p class="hint">Currently: {{paidCount}} selected · spent {{posTotal}} · gained {{negTotal}} ·
   <strong>net {{netBonus}}</strong> / {{netCap}}</p>

<h3>Chosen ({{taken.length}})</h3>
<div class="chosen-list">
  {{#each taken}}
  <div class="chosen {{#if free}}free{{/if}}">
    <span class="c-name">{{name}}
      <span class="c-meta">{{#if free}}racial · free{{else}}{{sign}}{{karma}} karma{{/if}}{{#if rating}} · rating {{rating}}{{/if}}</span>
    </span>
    {{#unless free}}
    <button type="button" class="x" data-action="removeQuality" data-genesis-id="{{genesisID}}">✕</button>
    {{/unless}}
    {{#unless free}}
    <input class="note-input" type="text" placeholder="Specifics (e.g. Allergy: peanuts, severe)"
           value="{{note}}" data-change="qualityNote" data-genesis-id="{{genesisID}}" />
    {{/unless}}
  </div>
  {{/each}}
</div>

<h3>Available</h3>
<div class="browser-head">
  <label class="field grow">
    <span class="field-label">Search</span>
    <input type="search" data-filter="quality" placeholder="Search qualities by name…" value="{{query}}" />
  </label>
  <label class="field">
    <span class="field-label">Kind</span>
    <select data-change="qualityFilter">
      <option value="all" {{#if (eq filter "all")}}selected{{/if}}>All</option>
      <option value="positive" {{#if (eq filter "positive")}}selected{{/if}}>Positive</option>
      <option value="negative" {{#if (eq filter "negative")}}selected{{/if}}>Negative</option>
    </select>
  </label>
</div>
{{#if truncated}}
<p class="hint">Showing the first {{list.length}} of {{listTotal}} — {{truncated}} more match; narrow with search.</p>
{{/if}}
<div class="browse-list" data-filter-scope="quality">
  {{#each list}}
  <div class="row" data-filter-text="{{name}}"
       data-detail-kind="uuid" data-detail-id="{{uuid}}">
    <span class="nm">{{name}}</span>
    <span class="mt">{{category}} · {{value}}</span>
    <button type="button" data-action="addQuality" data-genesis-id="{{genesisID}}" data-name="{{name}}"
            data-category="{{category}}" data-value="{{value}}">Add</button>
  </div>
  {{else}}
  <div class="browse-empty">No qualities match.</div>
  {{/each}}
</div>
