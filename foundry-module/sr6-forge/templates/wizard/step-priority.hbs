<h2>Priorities</h2>
<p>{{methodHint}}</p>
<table class="prio-table">
  <thead>
    <tr>{{#each columns}}<th>{{label}}</th>{{/each}}</tr>
    <tr>
      {{#each columns}}
      <td>
        <select data-change="priority" data-column="{{id}}">
          <option value="">—</option>
          {{#each ../letters}}
          <option value="{{this}}" {{#if (eq this ../current)}}selected{{/if}}>{{this}}</option>
          {{/each}}
        </select>
      </td>
      {{/each}}
    </tr>
  </thead>
  <tbody>
    {{#each grid}}
    <tr>
      {{#each cells}}
      <td class="{{#if picked}}picked{{/if}}"><span class="lt">{{../letter}}</span>{{text}}</td>
      {{/each}}
    </tr>
    {{/each}}
  </tbody>
</table>
{{#if sumInfo}}<p class="hint">{{sumInfo}}</p>{{/if}}
