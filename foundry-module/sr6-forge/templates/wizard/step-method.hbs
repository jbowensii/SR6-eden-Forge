<h2>Generation Method</h2>
<p>How this runner is built. Priority is the Core Rulebook standard; Sum-to-Ten trades letter uniqueness for a point total.</p>
<div class="method-list">
  {{#each methods}}
  <button type="button" class="method-card {{#if active}}active{{/if}}"
          data-action="pickMethod" data-method="{{id}}" {{#unless enabled}}disabled{{/unless}}>
    <span class="mc-name">{{label}}</span>
    <span class="mc-desc">{{desc}}</span>
  </button>
  {{/each}}
</div>

<h3>Rule interpretation</h3>
<select data-change="ruleset">
  {{#each rulesets}}
  <option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>
  {{/each}}
</select>
<p class="hint">Controls availability caps, leftover limits and optional rules.</p>
