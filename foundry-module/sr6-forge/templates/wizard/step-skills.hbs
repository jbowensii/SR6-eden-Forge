<h2>Skills</h2>
<p>A specialization costs 1 skill point. Restricted skills need the matching Magic/Resonance path.</p>
<p class="hint">{{skillKarmaHint}}</p>
<div class="browser-head">
  <label class="field">
    <span class="field-label">Search</span>
    <input type="search" data-filter="skill" placeholder="Filter skills by name…" value="{{query}}" />
  </label>
</div>
<table class="data" data-filter-scope="skill">
  <thead><tr><th>Skill</th><th style="width:96px">Points</th><th style="width:96px">Karma</th>
    <th style="width:52px">Rank</th><th>Specialization</th></tr></thead>
  <tbody>
    {{#each skills}}
    <tr class="{{#if locked}}locked{{/if}}" data-filter-text="{{label}}"
        data-detail-kind="skill" data-detail-id="{{id}}">
      <th>{{label}}{{#if restricted}} <span title="restricted">✦</span>{{/if}}</th>
      <td>
        <span class="rank">{{points}}</span>
        <span class="inline-step">
          <button type="button" data-action="adj" data-kind="skill" data-target="{{id}}"
                  data-delta="1" {{#if locked}}disabled{{/if}}>+</button>
          <button type="button" data-action="adj" data-kind="skill" data-target="{{id}}"
                  data-delta="-1">−</button>
        </span>
      </td>
      <td>
        <span class="rank">{{karma}}</span>
        <span class="inline-step">
          <button type="button" data-action="adj" data-kind="skill" data-pool="karma"
                  data-target="{{id}}" data-delta="1" title="Buy a rank with karma"
                  {{#if locked}}disabled{{/if}}>+</button>
          <button type="button" data-action="adj" data-kind="skill" data-pool="karma"
                  data-target="{{id}}" data-delta="-1">−</button>
        </span>
      </td>
      <td><span class="rank total">{{rank}}</span></td>
      <td>
        <select data-change="spec" data-skill="{{id}}" {{#unless points}}disabled{{/unless}}>
          <option value="">— none —</option>
          {{#each specs}}
          <option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>
          {{/each}}
        </select>
      </td>
    </tr>
    {{/each}}
  </tbody>
</table>

<h3>Knowledge &amp; Languages</h3>
<p class="hint">{{knowledgeHint}}</p>
<div class="chosen-list">
  {{#each knowledge}}
  <div class="chosen {{#if native}}free{{/if}}">
    <span class="c-name">{{name}}
      <span class="c-meta">{{type}}{{#if native}} · native{{/if}}</span>
    </span>
    <span>
      {{#unless native}}
      <span class="rank">{{points}}</span>
      <span class="inline-step">
        <button type="button" data-action="adj" data-kind="knowledgeRank" data-target="{{@index}}" data-delta="1">+</button>
        <button type="button" data-action="adj" data-kind="knowledgeRank" data-target="{{@index}}" data-delta="-1">−</button>
      </span>
      {{/unless}}
      <button type="button" class="x" data-action="removeKnowledge" data-index="{{@index}}">✕</button>
    </span>
  </div>
  {{/each}}
</div>
<div class="browser-head">
  <input type="text" name="knowledge-name" placeholder="e.g. Seattle Gangs / Japanese" />
  <select name="knowledge-type">
    <option value="knowledge">Knowledge</option>
    <option value="language">Language</option>
  </select>
  <label style="font-size:11px"><input type="checkbox" name="knowledge-native" /> native</label>
  <button type="button" data-action="addKnowledge">Add</button>
</div>
