{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sr6forge:spirits",
  "title": "SR6-eden-Forge spirits data file",
  "type": "object",
  "required": [
    "book",
    "domain",
    "category",
    "items"
  ],
  "additionalProperties": false,
  "properties": {
    "book": {
      "$ref": "urn:sr6forge:common#/$defs/slug"
    },
    "domain": {
      "const": "spirits"
    },
    "category": {
      "$ref": "urn:sr6forge:common#/$defs/slug"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "_notice": {
      "type": "string",
      "description": "Optional provenance/licensing notice. Used on the sample files in examples/ to state that they contain no copyrighted content."
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "required": [
        "id",
        "name",
        "system",
        "meta"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "urn:sr6forge:common#/$defs/slug"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "img": {
          "type": "string",
          "minLength": 1
        },
        "system": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "category": {
              "type": "string"
            },
            "rating": {
              "type": [
                "number",
                "string"
              ]
            },
            "attributes": {
              "type": "object",
              "additionalProperties": {
                "type": [
                  "number",
                  "string"
                ]
              }
            },
            "monitor": {
              "type": "object",
              "additionalProperties": {
                "type": [
                  "number",
                  "string"
                ]
              }
            },
            "movement": {
              "type": "object",
              "additionalProperties": {
                "type": [
                  "number",
                  "string"
                ]
              }
            },
            "page": {
              "type": "integer",
              "minimum": 0
            },
            "product": {
              "type": "string"
            },
            "genesisID": {
              "type": "string"
            },
            "metatype": {
              "type": "string"
            },
            "initiative": {
              "type": "string"
            },
            "defenserating": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "notes": {
              "type": "string"
            },
            "activeSkills": {
              "type": "string"
            },
            "knowledgeSkills": {
              "type": "string"
            },
            "languages": {
              "type": "string"
            },
            "qualities": {
              "type": "string"
            },
            "spells": {
              "type": "string"
            },
            "complexForms": {
              "type": "string"
            },
            "adeptPowers": {
              "type": "string"
            },
            "powers": {
              "type": "string"
            },
            "optionalPowers": {
              "type": "string"
            },
            "attacks": {
              "type": "string"
            },
            "bioware": {
              "type": "string"
            },
            "cyberware": {
              "type": "string"
            },
            "augmentations": {
              "type": "string"
            },
            "contacts": {
              "type": "string"
            },
            "lifestyle": {
              "type": "string"
            },
            "gear": {
              "type": "string"
            },
            "nuyen": {
              "type": "string"
            },
            "weapons": {
              "type": "string"
            },
            "skills": {
              "type": "string"
            },
            "weaknesses": {
              "type": "string"
            },
            "subtype": {
              "type": "string"
            },
            "spiritType": {
              "type": "string"
            },
            "defenseRating": {
              "type": "string"
            },
            "_cl6": {
              "type": "object"
            }
          }
        },
        "meta": {
          "$ref": "urn:sr6forge:common#/$defs/meta"
        }
      }
    }
  }
}
