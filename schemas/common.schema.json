{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sr6forge:common",
  "title": "SR6-eden-Forge shared definitions",
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_]*$"
    },
    "reference": {
      "type": "object",
      "required": [
        "book",
        "page"
      ],
      "additionalProperties": false,
      "properties": {
        "book": {
          "$ref": "#/$defs/slug"
        },
        "page": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "meta": {
      "type": "object",
      "required": [
        "book",
        "page",
        "extractedAt",
        "extractorVersion",
        "qaStatus"
      ],
      "additionalProperties": false,
      "properties": {
        "book": {
          "$ref": "#/$defs/slug"
        },
        "page": {
          "type": [
            "integer",
            "string"
          ],
          "minimum": 0
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          },
          "minItems": 1
        },
        "descriptionFrom": {
          "$ref": "#/$defs/slug"
        },
        "variantOf": {
          "$ref": "#/$defs/slug"
        },
        "extractedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "extractorVersion": {
          "type": "string",
          "minLength": 1
        },
        "qaStatus": {
          "enum": [
            "extracted",
            "reviewed",
            "approved"
          ]
        },
        "notes": {
          "type": "string"
        },
        "hidden": {
          "type": "boolean"
        },
        "source": {
          "type": "string"
        },
        "descriptionFrom_text": {
          "type": "string"
        }
      }
    }
  }
}
