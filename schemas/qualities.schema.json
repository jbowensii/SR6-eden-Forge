{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sr6forge:qualities",
  "title": "SR6-eden-Forge qualities data file",
  "type": "object",
  "required": [
    "book",
    "domain",
    "category",
    "items"
  ],
  "additionalProperties": false,
  "properties": {
    "book": {
      "$ref": "urn:sr6forge:common#/$defs/slug"
    },
    "domain": {
      "const": "qualities"
    },
    "category": {
      "$ref": "urn:sr6forge:common#/$defs/slug"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "_notice": {
      "type": "string",
      "description": "Optional provenance/licensing notice. Used on the sample files in examples/ to state that they contain no copyrighted content."
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "required": [
        "id",
        "name",
        "system",
        "meta"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "urn:sr6forge:common#/$defs/slug"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "img": {
          "type": "string",
          "minLength": 1
        },
        "system": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "category": {
              "type": "string"
            },
            "value": {
              "type": "number"
            },
            "explain": {
              "type": "string"
            },
            "modifier": {
              "type": "number"
            },
            "level": {
              "type": "boolean"
            },
            "description": {
              "type": "string"
            },
            "product": {
              "type": "string"
            },
            "page": {
              "type": "integer",
              "minimum": 0
            },
            "genesisID": {
              "type": "string"
            },
            "subtype": {
              "type": "string"
            },
            "_cl6": {
              "type": "object"
            }
          }
        },
        "meta": {
          "$ref": "urn:sr6forge:common#/$defs/meta"
        }
      }
    }
  }
}
