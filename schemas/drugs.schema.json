{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sr6forge:drugs",
  "title": "SR6-eden-Forge drugs data file",
  "type": "object",
  "required": [
    "book",
    "domain",
    "category",
    "items"
  ],
  "additionalProperties": false,
  "properties": {
    "book": {
      "$ref": "urn:sr6forge:common#/$defs/slug"
    },
    "domain": {
      "const": "drugs"
    },
    "category": {
      "$ref": "urn:sr6forge:common#/$defs/slug"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "required": [
        "id",
        "name",
        "system",
        "meta"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "urn:sr6forge:common#/$defs/slug"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "img": {
          "type": "string",
          "minLength": 1
        },
        "system": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "category": {
              "const": "DRUG"
            },
            "vector": {
              "type": "string"
            },
            "speed": {
              "type": "string"
            },
            "duration": {
              "type": "string"
            },
            "power": {
              "type": "string"
            },
            "effect": {
              "type": "string"
            },
            "addictionRating": {
              "type": "string"
            },
            "addictionType": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "product": {
              "type": "string"
            },
            "genesisID": {
              "type": "string"
            },
            "subtype": {
              "type": "string"
            },
            "page": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "meta": {
          "$ref": "urn:sr6forge:common#/$defs/meta"
        }
      }
    }
  }
}
