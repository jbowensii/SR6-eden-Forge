{
  "files.eol": "\n",
  "editor.formatOnSave": true,
  "editor.tabSize": 2,
  "[python]": {
    "editor.tabSize": 4,
    "editor.defaultFormatter": "ms-python.black-formatter"
  },
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": ["extractor", "validator"],
  "json.schemas": [
    {
      "fileMatch": ["data/*/gear/*.json"],
      "url": "./schemas/gear.schema.json"
    }
  ],
  "files.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true
  },
  "search.exclude": {
    "export/**": true,
    "**/node_modules": true
  }
}
